MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/"
SARVAM_API_KEY="your-sarvam-api-key-here"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Sarvam TTS defaults (bulbul:v3 / shubh — v2 is deprecated)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Chat model: sarvam-105b-conversations (default) or sarvam-105b
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# ── Single Customer Demo Call (real outbound AI call) ──
# Controlled test recipient. Never commit real values; set locally only.
# The recipient must have explicitly opted in before DEMO_CALL_CONSENT=true.
DEMO_CALL_NAME=
DEMO_CALL_PHONE=
DEMO_CALL_EMAIL=
DEMO_CALL_CONSENT=false
# Optional script overrides (otherwise generated from merchant + discount):
# DEMO_CALL_OPENING=
# DEMO_CALL_SYSTEM_PROMPT=

# Telephony provider — Exotel Connect Voice AI (AgentStream).
# Docs: https://developer.exotel.com/docs/agentstream/connect-voice-ai
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
# Region base URL: https://api.in.exotel.com (India) or https://api.exotel.com (Singapore)
EXOTEL_BASE_URL=https://api.in.exotel.com
EXOTEL_STREAM_SAMPLE_RATE=16000

# Publicly reachable endpoints Exotel must reach (NOT localhost):
# wss base for the bidirectional media stream, https base for status callbacks.
PUBLIC_WS_URL=
PUBLIC_BASE_URL=
